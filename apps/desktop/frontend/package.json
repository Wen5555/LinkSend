{
  "name": "linksend-desktop",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": "^24.21.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "pnpm run typecheck && vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json && pnpm run typecheck:bindings",
    "typecheck:bindings": "tsc --noEmit -p tsconfig.bindings.json",
    "lint": "eslint src vite.config.ts",
    "test": "vitest run",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tanstack/react-query": "5.102.8",
    "@wailsio/runtime": "3.0.0-beta.18",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "9.39.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  }
}
